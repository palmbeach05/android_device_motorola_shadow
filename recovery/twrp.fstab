# mount point	fstype	device [device2]				flags

/system		ext3	/dev/block/mmcblk1p21				flags=display="System";backup=1;usermrf
/system_image	emmc	/dev/block/mmcblk1p21				flags=display="System Image";backup=1;flashimg=1;usermrf
/cache		auto	/dev/block/mmcblk1p22				flags=display="Cache";backup=1;wipeingui
/preinstall	ext3	/dev/block/mmcblk1p23				flags=display="Preinstall";backup=1;wipeingui
/data		auto	/dev/block/mmcblk1p24				flags=display="Data";backup=1;wipeingui;settingsstorage;length=-16384
/misc 		emmc	/dev/block/mmcblk1p18				flags=display="Misc";backup=0
/pds		ext3	/dev/block/mmcblk1p7				flags=display="PDS";backup=1
/external_sd	auto	/dev/block/mmcblk0p1 /dev/block/mmcblk0p2	flags=display="MicroSD Card";storage;removable
